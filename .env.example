# Copy to .env (repository root) or backend/.env — backend/.env wins if both exist
OPENAI_API_KEY=
# Leave empty for api.openai.com. Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=
CHEMOMNI_PROVIDER=openai   # openai | fake
CHEMOMNI_MODEL=gpt-6.1-sol
# none | low | medium | high. gpt-6.1-sol rejects anything but none with tools on Chat Completions.
# Leave empty to omit the parameter (Ollama etc.).
CHEMOMNI_REASONING_EFFORT=none
# CHEMOMNI_DB=/path/to/chemomni.sqlite   (default: backend/data/chemomni.sqlite)
CHEMOMNI_CONTEXT_BUDGET=24000
